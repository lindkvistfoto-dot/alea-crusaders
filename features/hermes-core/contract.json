      "source_formats": [
        "PNG",
        "JPEG",
        "WEBP"
      ],
      "source_min_edge": 640,
      "source_max_edge": 4096,
      "aspect": "square",
      "alpha": "opaque",
      "fit": "resize",
      "output_width": 640,
      "output_height": 640,
      "output_max_edge": 640,
      "max_webp_bytes": 500000,
      "quality_start": 90,
      "quality_min": 76,
      "quality_step": 3,
      "archive_folder_key": "spell_types.square",
      "path_segment": "spell-illustration"
