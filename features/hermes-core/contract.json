  "legacy_kind_profiles": {
    "spell": "spell-icon",
    "spell-cutout": "spell-cutout",
    "spell-illustration": "spell-illustration-square",
    "spell-illustration-wide": "spell-illustration-wide",
    "symbol": "symbol-icon",
    "skill": "skill-icon",
