      "aspect": "square",
      "alpha": "visible",
      "fit": "resize",
      "output_width": 640,
      "output_height": 640,
      "output_max_edge": 640,
      "max_webp_bytes": 500000,
      "quality_start": 90,
      "quality_min": 76,
      "quality_step": 3,
