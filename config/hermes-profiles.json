{
  "protocol": "HERMES",
  "version": "1.0",
  "policy": "forward-only",
  "profiles": {
    "arcane-spell-cutout": {
      "status": "pilot",
      "purpose": "transparent-spell-art-over-combat-gold-frame",
      "kind": "spell-cutout",
      "master_dir": "assets/hermes/originals/spell-cutout/<spell_key>",
      "source_format": "png",
      "source_aspect_ratio": "1:1",
      "source_minimum": "1024x1024",
      "source_maximum": "4096x4096",
      "source_alpha": "required-genuine-transparency",
      "delivery_format": "webp",
      "delivery_width": 640,
      "delivery_height": 640,
      "delivery_max_bytes": 500000,
      "transparency": "required-preserved",
      "storage_bucket": "alea-spell-art",
      "storage_path": "spell/<spell_uuid>/<deterministic_uuid>.webp",
      "database_table": "public.rule_spells",
      "database_column": "cutout_path",
      "overwrite_policy": "never-replace-existing-cutout",
      "pipeline": [
        "scripts/hermes_drive_intake.py",
        "scripts/hermes2_prepare.py",
        "scripts/hermes2_publish.ts"
      ],
      "verification": [
        "tests/test_hermes_spell_cutout.py",
        "tests/hermes-spell-cutout-profile.test.js",
        "HERMES SHA-256 source and storage readback",
        "database compare-and-set and readback",
        "spell admin and combat frame visual check"
      ]
    },
    "arcane-ivory-spell-icon": {
      "status": "active",
      "purpose": "spell-selector-and-cryptex",
      "master_dir": "assets/spells/arcane-ivory",
      "manifest": "assets/spells/arcane-ivory/manifest.json",
      "source_format": "png",
      "delivery_format": "webp",
      "aspect_ratio": "1:1",
      "delivery_width": 640,
      "delivery_height": 640,
      "max_bytes": 500000,
      "transparency": "required-preserved",
      "database_table": "public.rule_spells",
      "database_column": "icon_path",
      "pipeline": "scripts/optimize_arcane_ivory.py",
      "verification": [
        "scripts/hermes-verify.mjs",
        "scripts/optimize_arcane_ivory.py --check"
      ]
    },
    "arcane-mechanism-ui-link": {
      "status": "active",
      "purpose": "cryptex-carousel-moving-connector",
      "source_format": "png",
      "aspect_ratio": "3:2 | 4:3 | 3:4",
      "transparency": "required",
      "source_dir": "assets/hermes/originals/ui/arcane-mechanism-link",
      "delivery_path": "features/combat/arcane-mechanism-link.webp",
      "delivery_format": "webp",
      "delivery_width": 576,
      "delivery_height": 768,
      "max_bytes": 300000,
      "pipeline": "scripts/hermes_ui_prepare.py",
      "database_table": null,
      "database_column": null
    },
    "arcane-mechanism-ui-chamber": {
      "status": "active",
      "purpose": "cryptex-carousel-stationary-inner-chamber",
      "source_format": "png",
      "aspect_ratio": "3:1",
      "transparency": "forbidden",
      "source_dir": "assets/hermes/originals/ui/arcane-mechanism-chamber",
      "delivery_path": "features/combat/arcane-mechanism-chamber.webp",
      "delivery_format": "webp",
      "delivery_width": 768,
      "delivery_height": 256,
      "max_bytes": 300000,
      "pipeline": "scripts/hermes_ui_prepare.py",
      "database_table": null,
      "database_column": null
    },
    "arcane-gallery-overlay": {
      "status": "active",
      "purpose": "campaign-private-material-viewer-public-overlay-only",
      "source_format": "png",
      "aspect_ratio": "3:2",
      "source_dir": "assets/hermes/originals/ui/arcane-gallery-overlay",
      "delivery_path": "features/material/arcane-gallery-overlay.webp",
      "delivery_format": "webp",
      "delivery_width": 1152,
      "delivery_height": 768,
      "max_bytes": 300000,
      "transparency": "generated-alpha-mask-for-outer-background-picture-and-five-slots",
      "pipeline": "scripts/hermes_ui_prepare.py",
      "database_table": null,
      "database_column": null
    }
  }
}
